# mavora-agent.service — systemd unit for the Mavora Site Provisioning Agent
# SP-T-216 / agent/05 §37
#
# Security model: the agent runs as root and execs its helpers (write-vhost,
# wp-safe, firewall-apply) and system binaries (nginx -t, systemctl reload nginx)
# DIRECTLY. wp-safe then drops to the web user (nginx/www-data) to run WP-CLI. The
# privilege boundary is capabilities + filesystem confinement:
#
#   ProtectSystem=strict  → whole FS read-only except ReadWritePaths
#   ReadWritePaths        → webroot + nginx dirs + state dir + log dir
#   CapabilityBoundingSet → ONLY the caps the privileged ops actually need
#                           (file ownership/mode + drop to the web user)
#
# Capabilities granted (minimal set):
#   CAP_DAC_OVERRIDE  → write nginx vhost files regardless of dir mode
#   CAP_CHOWN/CAP_FOWNER → own/adjust files the helpers create
#   CAP_SETUID/CAP_SETGID → wp-safe drops to the web user for WP-CLI
#   CAP_KILL          → manage helper child processes / timeouts
#
# WHY NoNewPrivileges=no + NO seccomp options:
#   A seccomp syscall filter (@system-service) made the provision HANG SILENTLY at
#   the FIRST privileged helper exec — the service could only provision when run
#   manually as root without the sandbox. The agent legitimately forks bash +
#   WP-CLI (PHP) + MySQL client + nginx; a restrictive syscall filter is too fragile
#   for that workload. Every seccomp-based option (SystemCallFilter, RestrictSUIDSGID,
#   RestrictAddressFamilies, LockPersonality, ProtectKernel*) also forces
#   NoNewPrivileges=yes, which would (a) block the uid-0 exec rule from handing the
#   bounding-set caps to the root helpers and (b) neuter the privilege drop. So they
#   are all omitted and NoNewPrivileges is explicitly off. The security boundary is the
#   minimal capability set + the mount-based filesystem confinement above.
#
# PRIVILEGE DROP — setpriv/runuser, NOT sudo:
#   wp-safe drops to the web user via setpriv/runuser (setuid() syscall + CAP_SETUID),
#   not the setuid `sudo` binary — robust regardless of NoNewPrivileges and with no
#   sudoers dependency. The setuid drop clears caps, so WP-CLI/PHP runs with none.
#   deploy/sudoers/mavora-agent is VESTIGIAL.
#
# MemoryDenyWriteExecute intentionally OMITTED:
#   wp-safe runs PHP; some PHP/OPcache-JIT configs require W+X pages. MDWE would crash
#   WP-CLI silently on affected versions. Re-add only if the fleet PHP CLI has JIT off.
#
# IMPORTANT: ReadWritePaths values are injected by install.sh at install time.
#   The PLACEHOLDER_ tokens below are replaced during installation.
#   Do not edit this service file manually on the VPS — re-run the installer.
#
# NO inbound port is opened by this service. The agent is outbound-443 only.
# Port 80 is served by nginx (a separate service), not by this unit.

[Unit]
Description=Mavora Site Provisioning Agent
Documentation=https://docs.mavora.io/agent
After=network-online.target
Wants=network-online.target
# Do not start if networking is unavailable — agent is outbound-only
ConditionPathExists=/etc/mavora-agent/config.yaml

[Service]
Type=simple
User=root
Group=root

ExecStart=PLACEHOLDER_BINARY_PATH

Restart=always
RestartSec=5
StartLimitInterval=60
StartLimitBurst=5

# ── Hardening ──────────────────────────────────────────────────────────────
# Minimal capability set — ONLY what the privileged helpers need: write/own nginx
# vhost files (DAC_OVERRIDE/CHOWN/FOWNER), drop to the web user for WP-CLI
# (SETUID/SETGID), and manage helper child processes (KILL). Everything else is
# dropped, so a compromised agent cannot e.g. load modules, raw-net, or reboot.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID CAP_KILL
# No ambient caps: the root agent + its root helpers receive the bounding-set caps
# via the uid-0 exec rule, and the setpriv/runuser drop to the web user CLEARS all
# caps — so the WP-CLI/PHP process runs as the web user with ZERO capabilities.
AmbientCapabilities=

# NoNewPrivileges MUST stay off. It is required for (a) the uid-0 exec rule to hand
# the bounding-set caps to the root helpers, and (b) the privilege drop. Enabling it
# (which any seccomp-based option below would force) caused the provision to HANG at
# the first helper exec — the service could then only provision when run manually as
# root. That is why SystemCallFilter / RestrictSUIDSGID / RestrictAddressFamilies /
# LockPersonality / ProtectKernel* (all seccomp-based → force NoNewPrivileges=yes) are
# intentionally NOT used here. The security boundary is capabilities + the mount-based
# filesystem confinement below.
NoNewPrivileges=no

# Whole filesystem read-only except ReadWritePaths.
ProtectSystem=strict

# No access to /home, /root, or /run/user.
ProtectHome=yes

# Private /tmp — isolated from other services.
PrivateTmp=yes

# Cannot modify cgroup hierarchy (mount-based; does not force NoNewPrivileges).
ProtectControlGroups=yes

# MemoryDenyWriteExecute also absent — see header comment above.

# ── ReadWritePaths ─────────────────────────────────────────────────────────
# MUST include:
#   - state_dir:        idempotency store (JSON + flock)
#   - log_dir:          structured log output
#   - nginx sites dirs: write-vhost helper writes here (direct exec as root)
#   - webroot:          WP-CLI (as www-data via wp-safe) writes uploads/cache
#
# These are PLACEHOLDER_ tokens replaced by install.sh with actual paths.
ReadWritePaths=PLACEHOLDER_WEBROOT PLACEHOLDER_NGINX_SITES_AVAILABLE PLACEHOLDER_NGINX_SITES_ENABLED PLACEHOLDER_STATE_DIR /var/log/mavora-agent

[Install]
WantedBy=multi-user.target
