#!/usr/bin/env bash
# wp-safe — Allowlisted WP-CLI wrapper helper (SP-T-216)
#
# SECURITY INVARIANTS:
#   - Root-owned 0755; exec'd DIRECTLY by the root agent (no sudo/sudoers)
#   - --path is FIXED from WP_PATH env var (set by agent from config, NOT from payload)
#   - Only allowlisted subcommand groups are permitted
#   - All argv is validated for metachar and traversal before exec
#   - Drops to the web user (EXEC_AS) via setpriv/runuser before executing wp.
#     (NOT sudo: the hardened systemd unit sets NoNewPrivileges, which neuters the
#     setuid sudo binary. setpriv/runuser use setuid() directly — the service holds
#     CAP_SETUID/SETGID — so they drop privileges correctly under NoNewPrivileges.)
#   - Uses argv array (exec, NO shell interpolation)
#   - --format=json enforced on data-output commands
#   - NEVER accepts --path from caller arguments (SSRF/traversal prevention)
#
# Usage (called directly by the root agent):
#   sudo wp-safe site list [--url=<url>] [--format=json]
#   sudo wp-safe site create-mapped <domain> [<title>]   # wpmu_create_blog(domain,'/',...)
#   sudo wp-safe site deactivate <blog_id> [--url=<url>]
#   sudo wp-safe site delete <blog_id> [--yes] [--url=<url>]
#   sudo wp-safe user create <login> <email> --role=<role>
#   sudo wp-safe user get <login> --format=json
#   sudo wp-safe user delete <login> [--yes] [--reassign=<id>]
#   sudo wp-safe user application-password create <login> --name=<name>
#   sudo wp-safe user application-password delete <login> <uuid>
#   sudo wp-safe db check
#
# WP_PATH env var MUST be set by the agent (fixed path from config).
# EXEC_AS env var MUST be set by the agent (user to drop to; typically www-data).

set -euo pipefail
IFS=$'\n\t'

# PATH may be a restricted secure_path under sudo/systemd (excludes /usr/local/bin,
# the usual wp-cli + php location). Prepend common bin dirs so wp-cli and its php
# interpreter resolve regardless of how the agent process was launched.
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH:-}"

# Pin the PHP interpreter for WP-CLI so it resolves even if the privilege-drop tool
# sanitises PATH (setpriv preserves env; runuser may reset PATH).
export WP_CLI_PHP="${WP_CLI_PHP:-$(command -v php 2>/dev/null || true)}"

fail() { echo "wp-safe ERROR: $*" >&2; exit 1; }

# drop_and_exec — exec the given argv as EXEC_AS (the web user), dropping root.
# Uses a capability-based dropper, NOT sudo: under the hardened systemd unit
# NoNewPrivileges is set, which neuters setuid binaries like sudo. setpriv/runuser
# call setuid()/setgid() directly (the service holds CAP_SETUID/SETGID), so they
# work under NoNewPrivileges. setpriv is preferred (preserves the full environment,
# incl. the PATH/WP_CLI_PHP we exported); runuser and sudo are fallbacks.
drop_and_exec() {
    local gid home
    gid="$(id -g "$EXEC_AS" 2>/dev/null || true)"
    # setpriv preserves the environment, so point HOME at the web user's home (else
    # HOME leaks as root's /root and WP-CLI cache writes fail). runuser/sudo reset it.
    home="$(getent passwd "$EXEC_AS" 2>/dev/null | cut -d: -f6 || true)"
    [[ -n "$home" ]] && export HOME="$home"
    if [[ -n "$gid" ]] && command -v setpriv >/dev/null 2>&1; then
        exec setpriv --reuid "$EXEC_AS" --regid "$gid" --init-groups -- "$@"
    elif command -v runuser >/dev/null 2>&1; then
        exec runuser -u "$EXEC_AS" -- "$@"
    else
        exec sudo -u "$EXEC_AS" -- "$@"
    fi
}

# ─────────────────────────── required env ────────────────────────────────────
WP_PATH="${WP_PATH:-}"

[[ -n "$WP_PATH" ]] || fail "WP_PATH env var must be set by agent (WordPress root path)."
[[ -d "$WP_PATH" ]] || fail "WP_PATH directory does not exist: $WP_PATH"

# Drop-to user: honour an agent-set EXEC_AS, else auto-detect from the WordPress
# root owner — nginx on RHEL/AlmaLinux, www-data on Debian/Ubuntu. Auto-detection
# avoids per-OS config drift; the root owner is the user that must own WP writes.
EXEC_AS="${EXEC_AS:-$(stat -c '%U' "$WP_PATH")}"
[[ -n "$EXEC_AS" ]] || fail "cannot determine EXEC_AS (WordPress root owner)."
id -u "$EXEC_AS" >/dev/null 2>&1 || fail "EXEC_AS user does not exist: $EXEC_AS"

# ─────────────────────────── wp binary ───────────────────────────────────────
WP_BIN="$(command -v wp 2>/dev/null || true)"
if [[ -z "$WP_BIN" ]]; then
    for cand in /usr/local/bin/wp /usr/bin/wp /bin/wp /usr/local/sbin/wp /snap/bin/wp; do
        [[ -x "$cand" ]] && { WP_BIN="$cand"; break; }
    done
fi
[[ -n "$WP_BIN" && -x "$WP_BIN" ]] || fail "wp-cli binary not found in PATH or common locations (/usr/local/bin/wp, /usr/bin/wp)."

# ─────────────────────────── subcommand allowlist ────────────────────────────
ALLOWED_GROUPS=("site" "user" "db" "option")
# create-mapped is handled by a dedicated branch below (it is NOT a real WP-CLI
# subcommand — it runs wpmu_create_blog via `wp eval`), so it is intentionally
# absent from this generic list.
ALLOWED_SITE_CMDS=("list" "deactivate" "delete")
ALLOWED_USER_CMDS=("create" "get" "delete" "application-password")
ALLOWED_USER_APPPW_CMDS=("create" "delete")
ALLOWED_DB_CMDS=("check")
ALLOWED_OPTION_CMDS=("get" "update")
# HARD CONSTRAINT: the option group may only touch these exact option keys.
# Any other key is rejected — a compromised agent cannot read/write arbitrary WP options.
#   mavora_provisioning_id → ownership marker (SP-SG-01)
#   admin_email / WPLANG   → wp_options applied at provision time (§10.2)
ALLOWED_OPTION_KEYS=("mavora_provisioning_id" "admin_email" "WPLANG")

# ─────────────────────────── arg validation ──────────────────────────────────
validate_arg() {
    local arg="$1"
    # Reject shell metachar
    if echo "$arg" | grep -qE '[;&|$`<>(){}\\]'; then
        fail "Argument contains forbidden shell metacharacter: $arg"
    fi
    # Reject path traversal
    if echo "$arg" | grep -q '\.\.'; then
        fail "Argument contains path traversal: $arg"
    fi
}

validate_slug() {
    local slug="$1"
    [[ "$slug" =~ ^[a-zA-Z0-9._-]+$ ]] || fail "Invalid slug/username (only alphanumeric, '.', '-', '_'): $slug"
}

validate_uuid() {
    local uuid="$1"
    [[ "$uuid" =~ ^[0-9a-fA-F-]{36}$ ]] || fail "Invalid UUID format: $uuid"
}

# ─────────────────────────── build exec argv ─────────────────────────────────
[[ $# -ge 2 ]] || fail "Usage: wp-safe <group> <subcommand> [args...]"

GROUP="$1"; shift
SUBCMD="$1"; shift

# Validate top-level group
FOUND_GROUP=false
for g in "${ALLOWED_GROUPS[@]}"; do
    [[ "$GROUP" == "$g" ]] && FOUND_GROUP=true && break
done
$FOUND_GROUP || fail "Subcommand group not allowed: $GROUP (allowed: ${ALLOWED_GROUPS[*]})"

# Build base argv — --path is FIXED from WP_PATH (not from caller)
ARGV=("$WP_BIN" "$GROUP" "$SUBCMD" "--path=${WP_PATH}")

case "$GROUP" in
    site)
        # ── create-mapped: bind a subsite to a FULL separate domain ──────────────
        # WP-CLI `site create --slug` can only build a domain from the network root;
        # mapping an arbitrary separate domain requires wpmu_create_blog(domain,'/',…),
        # which inserts wp_blogs.domain=<domain>, path='/' directly. WordPress core then
        # serves that domain by matching wp_blogs.domain — no sunrise.php / domain-mapping
        # plugin needed. This is a dedicated, tightly-scoped op: the PHP template is FIXED
        # here and ONLY the strictly-validated domain + title are substituted, so the
        # caller cannot inject PHP (both are constrained to a metachar-free charset).
        if [[ "$SUBCMD" == "create-mapped" ]]; then
            [[ $# -ge 1 ]] || fail "wp site create-mapped requires <domain> [<title>]"
            # lowercase — WP stores domains lowercase (tr for shell portability).
            MAP_DOMAIN="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"; shift
            MAP_TITLE="${1:-$MAP_DOMAIN}"
            [[ $# -ge 1 ]] && shift || true
            # Hard charset guard FIRST (libc-independent). A `case` glob matches the whole
            # string char-by-char and is NOT line-oriented, so an embedded newline or
            # control char is caught here. This does NOT rely on `[[ =~ ^…$ ]]`, whose `$`
            # can match *before* an embedded newline under glibc regexec — a newline-
            # injection bypass that would let "<valid>\n\";system(...);//" reach `wp eval`.
            case "$MAP_DOMAIN" in *[!a-z0-9.-]*) fail "Invalid domain (charset) for create-mapped: $MAP_DOMAIN" ;; esac
            case "$MAP_TITLE"  in *[!A-Za-z0-9._\ -]*) fail "Invalid title (charset) for create-mapped: $MAP_TITLE" ;; esac
            # Structural validation: dot-separated labels, no leading/trailing hyphen.
            DOMAIN_RE='^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$'
            [[ "$MAP_DOMAIN" =~ $DOMAIN_RE ]] || fail "Invalid domain for create-mapped: $MAP_DOMAIN"
            TITLE_RE='^[A-Za-z0-9._ -]+$'
            [[ "$MAP_TITLE" =~ $TITLE_RE ]] || fail "Invalid title for create-mapped: $MAP_TITLE"
            # FIXED PHP template — only the validated $MAP_DOMAIN / $MAP_TITLE are substituted.
            PHP_CODE="\$id = wpmu_create_blog(\"${MAP_DOMAIN}\", \"/\", \"${MAP_TITLE}\", 1);"
            PHP_CODE+=" if ( is_wp_error( \$id ) ) { fwrite( STDERR, 'WPERR:' . \$id->get_error_code() ); exit( 1 ); }"
            PHP_CODE+=" echo (int) \$id;"
            drop_and_exec "$WP_BIN" eval "$PHP_CODE" "--path=${WP_PATH}"
        fi

        FOUND=false
        for c in "${ALLOWED_SITE_CMDS[@]}"; do [[ "$SUBCMD" == "$c" ]] && FOUND=true && break; done
        $FOUND || fail "wp site $SUBCMD not allowed (allowed: ${ALLOWED_SITE_CMDS[*]})"

        # Validate remaining args
        for arg in "$@"; do
            validate_arg "$arg"
            ARGV+=("$arg")
        done
        # Always add --format=json for list
        if [[ "$SUBCMD" == "list" ]]; then
            ARGV+=("--format=json")
        fi
        ;;

    user)
        if [[ "$SUBCMD" == "application-password" ]]; then
            [[ $# -ge 1 ]] || fail "wp user application-password requires a subcommand (create|delete)"
            APPPW_CMD="$1"; shift
            FOUND=false
            for c in "${ALLOWED_USER_APPPW_CMDS[@]}"; do [[ "$APPPW_CMD" == "$c" ]] && FOUND=true && break; done
            $FOUND || fail "wp user application-password $APPPW_CMD not allowed"
            ARGV+=("$APPPW_CMD")
            for arg in "$@"; do
                validate_arg "$arg"
                ARGV+=("$arg")
            done
            # Enforce json output for create
            if [[ "$APPPW_CMD" == "create" ]]; then
                ARGV+=("--porcelain")  # outputs raw password only
            fi
        else
            FOUND=false
            for c in "${ALLOWED_USER_CMDS[@]}"; do [[ "$SUBCMD" == "$c" ]] && FOUND=true && break; done
            $FOUND || fail "wp user $SUBCMD not allowed (allowed: ${ALLOWED_USER_CMDS[*]})"
            for arg in "$@"; do
                validate_arg "$arg"
                ARGV+=("$arg")
            done
            if [[ "$SUBCMD" == "get" ]]; then
                ARGV+=("--format=json")
            fi
        fi
        ;;

    db)
        FOUND=false
        for c in "${ALLOWED_DB_CMDS[@]}"; do [[ "$SUBCMD" == "$c" ]] && FOUND=true && break; done
        $FOUND || fail "wp db $SUBCMD not allowed (allowed: ${ALLOWED_DB_CMDS[*]})"
        for arg in "$@"; do
            validate_arg "$arg"
            ARGV+=("$arg")
        done
        ;;

    option)
        # Only get and update are allowed; key is restricted to ALLOWED_OPTION_KEY.
        FOUND=false
        for c in "${ALLOWED_OPTION_CMDS[@]}"; do [[ "$SUBCMD" == "$c" ]] && FOUND=true && break; done
        $FOUND || fail "wp option $SUBCMD not allowed (allowed: ${ALLOWED_OPTION_CMDS[*]})"

        # First remaining arg must be the option key — enforce it.
        [[ $# -ge 1 ]] || fail "wp option $SUBCMD requires an option key argument"
        OPTION_KEY="$1"; shift
        KEY_OK=false
        for k in "${ALLOWED_OPTION_KEYS[@]}"; do
            [[ "$OPTION_KEY" == "$k" ]] && KEY_OK=true && break
        done
        $KEY_OK || fail "wp option key not allowed: '$OPTION_KEY' (allowed: ${ALLOWED_OPTION_KEYS[*]})"
        ARGV+=("$OPTION_KEY")

        # Remaining args (e.g. the value for 'update', --url=, --format=) are validated.
        for arg in "$@"; do
            validate_arg "$arg"
            ARGV+=("$arg")
        done
        ;;
esac

# ─────────────────────────── exec as the web user ────────────────────────────
# exec → no subshell; argv slice → no interpolation; drop root → EXEC_AS.
drop_and_exec "${ARGV[@]}"
